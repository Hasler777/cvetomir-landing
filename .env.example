NEXT_PUBLIC_SITE_URL=https://cvetomir-franchise.ru

# Telegram-уведомления о заявках с формы (серверные секреты, в git не коммитим).
# Локально — положить в .env.local. На сервере — в /var/www/cvetomir/shared/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Админка заявок (/admin). Пароль для входа — обязателен, иначе админка не работает.
ADMIN_PASSWORD=

# Каталог для хранения заявок (leads.jsonl). Локально по умолчанию — папка .data.
# На сервере задать постоянный путь, переживающий редеплои, напр. /var/www/cvetomir/shared.
DATA_DIR=
